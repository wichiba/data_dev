        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/html",
        "body": "={{ $json.final_html }}",
        "options": {}
      },
      "id": "ab57a1bc-86c7-43d3-9a89-1cc81dcdf168",
