              "value": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Dashboard Gamification Black Friday 2026 | Sellers MLB</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  :root{--yellow:#FFE600;--yellow-soft:#FFFBD6;--ink:#111;--ink-soft:#62625f;--paper:#FBFBF9;--panel:#fff;--line:#E9E8E2;--caution:#B34700;--caution-bg:#FFF6EC;--ok:#1a7f37;--ok-bg:#EFF9F1;\n        --mono:'IBM Plex Mono','SF Mono',Consolas,monospace;--heading:'Archivo',sans-serif;--body:'Inter',-apple-system,sans-serif;}\n  *{box-sizing:border-box;}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);-webkit-font-smoothing:antialiased;}\n  button,input,select{font-family:inherit;}\n  button:focus-visible,select:focus-visible,input:focus-visible,th[data-sort]:focus-visible{outline:3px solid var(--yellow);outline-offset:2px;box-shadow:0 0 0 1.5px var(--ink);}\n\n  .topbar{background:var(--ink);color:#fff;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}\n  .topbar-left{display:flex;align-items:center;gap:10px;font-family:var(--heading);font-weight:800;font-size:16px;}\n  .logo{height:30px;width:auto;display:block;}\n  .logo-badge{height:30px;min-width:42px;padding:0 8px;border-radius:15px;background:var(--yellow);color:#2D3277;display:inline-flex;align-items:center;justify-content:center;font-family:var(--heading);font-weight:900;font-size:14px;letter-spacing:-.02em;}\n  .topbar-right{font-size:12.5px;color:var(--yellow);font-weight:600;}\n  .wrap{max-width:1380px;margin:0 auto;padding:0 28px 90px;}\n\n  header.hero{padding:38px 0 6px;}\n  .accent-bar{height:6px;width:56px;background:var(--yellow);border-radius:3px;margin-bottom:20px;}\n  h1{font-family:var(--heading);font-weight:900;font-size:clamp(26px,3.4vw,38px);line-height:1.1;margin:0 0 12px;letter-spacing:-.02em;max-width:860px;}\n  .lede{font-size:15.5px;color:var(--ink-soft);max-width:760px;line-height:1.55;margin:0;}\n  .gen-note{font-size:11.5px;color:#a7a59a;margin-top:14px;font-family:var(--mono);}\n\n  .toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:26px 0 20px;}\n  .tabs{display:inline-flex;flex-wrap:wrap;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:4px;gap:2px;}\n  .tabs button{font-family:var(--heading);font-weight:700;font-size:13.5px;padding:9px 20px;border:none;border-radius:999px;background:transparent;color:var(--ink);cursor:pointer;}\n  .tabs button[aria-selected=\"true\"]{background:var(--ink);color:var(--yellow);}\n  .tabs button[aria-selected=\"false\"]:hover{background:var(--line);}\n  .meta-pill{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);}\n  .meta-pill strong{font-family:var(--heading);font-weight:900;font-size:15px;color:var(--ink);background:var(--yellow);padding:4px 11px;border-radius:999px;}\n  .tabpanel[hidden]{display:none;}\n\n  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;}\n  .card{background:#fff;border:1.5px solid var(--line);border-left-width:5px;border-radius:14px;padding:20px 22px;text-align:left;font:inherit;color:inherit;display:block;width:100%;}\n  button.card{cursor:pointer;transition:transform .15s,border-color .15s;} button.card:hover{transform:translateY(-2px);border-color:var(--ink);}\n  button.card.ok:hover{border-left-color:var(--ok);} button.card.bad:hover{border-left-color:var(--caution);}\n  .card.ok{border-left-color:var(--ok);} .card.bad{border-left-color:var(--caution);}\n  .card.total{background:var(--ink);color:#fff;border-color:var(--ink);border-left-color:var(--yellow);}\n  .card .lab{font-size:13px;color:var(--ink-soft);margin-bottom:8px;font-weight:500;}\n  .card.total .lab{color:#c9c8c0;}\n  .card .num{font-family:var(--heading);font-weight:900;font-size:clamp(36px,4.4vw,52px);line-height:1;letter-spacing:-.025em;font-variant-numeric:tabular-nums;}\n  .card.total .num{color:var(--yellow);} .card.ok .num{color:var(--ok);} .card.bad .num{color:var(--caution);}\n  .card .row{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:12.5px;color:var(--ink-soft);}\n  .card.total .row{color:#c9c8c0;}\n  .badge{display:inline-flex;font-family:var(--mono);font-size:12.5px;font-weight:600;padding:5px 10px;border-radius:999px;white-space:nowrap;}\n  .badge.okb{background:var(--ok-bg);color:#14532d;border:1.5px solid var(--ok);padding:3.5px 9px;}\n  .badge.warnb{background:var(--caution-bg);color:#5c2700;border:1.5px solid var(--caution);padding:3.5px 9px;}\n  .badge.y{background:var(--yellow);color:var(--ink);}\n  .badge.sm{font-size:10.5px;padding:2px 8px;}\n\n  .split{margin:16px 0 0;background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:16px 20px;}\n  .split-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-soft);margin-bottom:10px;}\n  .split-top b{font-family:var(--mono);color:var(--ink);}\n  .split-bar{display:flex;height:14px;border-radius:99px;overflow:hidden;background:var(--line);}\n  .split-bar i{display:block;height:100%;transform-origin:left;}\n  .split-bar .s-ok{background:var(--ok);} .split-bar .s-bad{background:var(--caution);}\n  .split-bar i+i{margin-left:2px;}\n\n  .panel{background:var(--panel);border:1.5px solid var(--line);border-radius:14px;padding:18px 20px;margin-top:26px;}\n  .panel-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:14px;}\n  .panel-head h2{font-family:var(--heading);font-size:18px;font-weight:800;margin:0;letter-spacing:-.01em;}\n  .panel-head p{margin:4px 0 0;font-size:13px;color:var(--ink-soft);}\n  .controls{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}\n  .search{flex:1 1 240px;max-width:340px;position:relative;}\n  .search input{width:100%;padding:10px 12px;font-size:14px;border:1.5px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);}\n  .search input:focus{border-color:var(--ink);}\n  .quick{display:flex;gap:6px;flex-wrap:wrap;}\n  .quick button{font-family:var(--mono);font-size:12px;padding:8px 11px;border-radius:8px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink-soft);cursor:pointer;}\n  .quick button:hover{border-color:var(--ink);color:var(--ink);background:var(--yellow);}\n  .quick button.on{border-color:var(--ink);background:var(--yellow);color:var(--ink);font-weight:600;}\n  .ghost{font-family:var(--mono);font-size:12px;font-weight:600;padding:8px 12px;border-radius:8px;border:1.5px solid var(--ink);background:#fff;color:var(--ink);cursor:pointer;margin-left:auto;}\n  .ghost:hover{background:var(--yellow);}\n  .legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-soft);margin-bottom:12px;align-items:center;}\n  .legend span{display:inline-flex;align-items:center;gap:7px;}\n  .lg{width:26px;height:10px;border:1.5px solid var(--ink);border-radius:5px;display:inline-block;} .lg.y{background:var(--yellow);} .lg.g{background:var(--ok);border-color:var(--ok);}\n  .key-dot{width:12px;height:12px;border-radius:3px;background:var(--yellow);border:1.5px solid var(--ink);display:inline-block;}\n\n  .tw{overflow:auto;height:78vh;min-height:360px;background:#fff;border:1.5px solid var(--line);border-radius:12px;}\n  table.dt{border-collapse:separate;border-spacing:0;width:100%;font-size:12px;}\n  table.dt th{position:sticky;top:0;z-index:2;font-size:11px;color:var(--ink-soft);font-weight:600;text-align:right;padding:8px 10px;line-height:1.25;border-bottom:1.5px solid var(--line);white-space:nowrap;background:var(--paper);user-select:none;}\n  table.dt th.l,table.dt td.l{text-align:left;}\n  table.dt th[data-sort]{cursor:pointer;} table.dt th[data-sort]:hover{background:var(--yellow);color:var(--ink);}\n  table.dt th.key{background:var(--yellow);color:var(--ink);font-weight:700;border-bottom-color:var(--ink);}\n  table.dt th.key:hover{background:#ffd900;}\n  table.dt th .ar{display:inline-block;width:12px;margin-left:4px;font-size:10px;color:var(--ink);}\n  table.dt tbody td{height:40px;padding-top:0;padding-bottom:0;vertical-align:middle;}\n  table.dt tr.sp td{padding:0;border:none;background:none;}\n  table.dt td{padding:4px 10px;border-bottom:1px solid var(--line);text-align:right;font-family:var(--mono);white-space:nowrap;font-variant-numeric:tabular-nums;}\n  table.dt td.l{font-weight:600;}\n  table.dt td.key{background:var(--yellow-soft);}\n  table.dt tbody tr:hover td{background:#F6F5EF;} table.dt tbody tr:hover td.key{background:#FFF6A8;}\n  table.dt tr:last-child td{border-bottom:none;}\n  td.mut{color:#a7a59a;}\n  td.prog{min-width:170px;text-align:left;}\n  .pg-top{display:flex;justify-content:space-between;gap:10px;align-items:baseline;margin-bottom:3px;font-size:11px;line-height:1.2;}\n  .pg-top strong{font-family:var(--mono);font-weight:600;} .pg-top span{font-size:10.5px;color:var(--ink-soft);}\n  .t-bad{color:var(--caution);} .t-ok{color:var(--ok);}\n  .pg-bar{height:7px;border-radius:99px;background:#fff;border:1.5px solid var(--ink);overflow:hidden;}\n  .pg-bar i{display:block;height:100%;background:var(--yellow);border-radius:99px;transform-origin:left;}\n  .pg-bar.hit{border-color:var(--ok);} .pg-bar.hit i{background:var(--ok);}\n  .pg-bar.none{border-color:var(--line);background:var(--paper);}\n  .intro .pg-bar i{animation:grow .9s cubic-bezier(.2,.7,.2,1) both;}\n  .intro .split-bar i{animation:grow 1s cubic-bezier(.2,.7,.2,1) both;}\n  @keyframes grow{from{transform:scaleX(0);}to{transform:scaleX(1);}}\n\n  .foot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px;font-size:12.5px;color:var(--ink-soft);}\n  .empty{padding:36px 20px;text-align:center;color:var(--ink-soft);font-size:14px;}\n\n  .goals{margin-top:16px;padding-top:6px;border-top:1px solid var(--line);}\n  .goal{display:grid;grid-template-columns:minmax(230px,auto) 1fr auto;gap:14px;align-items:center;margin-top:10px;font-size:12.5px;}\n  .goal .gl{color:var(--ink);font-weight:500;} .goal .gn{color:var(--ink-soft);white-space:nowrap;} .goal .gn b{font-family:var(--mono);color:var(--ink);}\n  .gbar{height:8px;border-radius:99px;background:var(--line);overflow:hidden;} .gbar i{display:block;height:100%;background:var(--ok);border-radius:99px;transform-origin:left;}\n  .intro .gbar i{animation:grow 1s cubic-bezier(.2,.7,.2,1) both;}\n  @media(max-width:720px){.goal{grid-template-columns:1fr;gap:4px;}}\n  @media(max-width:720px){.wrap{padding:0 16px 70px;}.topbar{padding:12px 16px;}.ghost{margin-left:0;}}\n  @media(prefers-reduced-motion:reduce){.intro .pg-bar i,.intro .split-bar i,.intro .gbar i{animation:none;}button.card{transition:none;}}\n</style>\n</head>\n<body>\n<div class=\"topbar\"><div class=\"topbar-left\"><span class=\"logo-badge\">ML</span>Mercado Livre</div><div class=\"topbar-right\">Dashboard Gamification Black Friday 2026</div></div>\n<div class=\"wrap\">\n  <header class=\"hero\">\n    <div class=\"accent-bar\"></div>\n    <h1>Gamification Black Friday 2026 | <br> Sellers MLB</h1>\n    <p class=\"lede\">Dashboard de acompanhamento do atingimento da meta dos sellers</p>\n    <p class=\"gen-note\" id=\"gen-note\"></p>\n  </header>\n\n  <div class=\"toolbar\">\n    <div class=\"tabs\" role=\"tablist\" aria-label=\"Programas\">\n      <button type=\"button\" role=\"tab\" id=\"tab-cp\" aria-selected=\"true\" aria-controls=\"panel-cp\">Central de Promoções</button>\n      <button type=\"button\" role=\"tab\" id=\"tab-aff\" aria-selected=\"false\" aria-controls=\"panel-aff\">Afiliados</button>\n      <button type=\"button\" role=\"tab\" id=\"tab-mp\" aria-selected=\"false\" aria-control