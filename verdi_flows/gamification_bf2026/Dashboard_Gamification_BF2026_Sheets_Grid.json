ade que bateu a meta', orig: 'QUANTOS BATERAM A META', type: 'int' },\n    { i: 5, label: 'Atingimento', orig: 'ATINGIMENTO', type: 'prog' }\n    ]\n}\n};\n\n// ---------------------------------------------------------------- células\nfunction progCell(t, v){\n  if(v === null || v === undefined || v === '') return '<td class=\"prog key\"><div class=\"pg-top\"><strong class=\"mut\">–</strong></div><div class=\"pg-bar none\"></div></td>';\n  const value = typeof v === 'number' ? v : Number(String(v).replace('%', '').replace(',', '.'));\n  if(!Number.isFinite(value)) return '<td class=\"prog key\"><div class=\"pg-top\"><strong class=\"mut\">–</strong></div><div class=\"pg-bar none\"></div></td>';\n  const ratio = (t.id === 'acc' && String(v).includes('%')) ? value / 100 : value;\n  const pct = ratio * 100;\n  const hit = ratio >= 1;\n  const fill = Math.max(0, Math.min(1, ratio));\n  const shownPct = hit ? pct : Math.min(99.99, pct);\n  const miss = (hit || t.noMiss) ? '' : 'Faltam '+nDec(Math.max(0.01, 100 - shownPct))+' p.p.';\n  return '<td class=\"prog key\"><div class=\"pg-top\"><strong class=\"'+(hit?'t-ok':'t-bad')+'\">'+nDec(shownPct)+'%</strong><span>'+miss+'</span></div>'+\n         '<div class=\"pg-bar'+(hit?' hit':'')+'\" role=\"img\" aria-label=\"'+nDec(shownPct)+'% da meta\"><i style=\"width:'+(fill*100).toFixed(2)+'%\"></i></div></td>';\n}\nfunction cell(t, c, row){\n  const v = row[c.i], k = c.key ? ' key' : '';\n  const vazio = v === null || v === undefined || v === '';\n  switch(c.type){\n    case 'id':   return '<td class=\"l\">'+esc(v)+'</td>';\n    case 'txt':  return vazio ? '<td class=\"mut l\">–</td>' : '<td class=\"l\">'+esc(typeof v==='number' ? nDec(v) : v)+'</td>';\n    case 'prog': return progCell(t, v);\n    case 'flag': return '<td class=\"'+k.trim()+'\"><span class=\"badge sm '+(v===true?'okb':'warnb')+'\">'+(v===true?c.yes:c.no)+'</span></td>';\n    case 'brl':  return vazio ? '<td class=\"mut\">–</td>' : '<td>'+nBRL(v)+'</td>';\n    case 'pct':  return vazio ? '<td class=\"mut\">–</td>' : '<td>'+nPct(v,2)+'</td>';\n    case 'pct2': return vazio ? '<td class=\"mut\">–</td>' : '<td>'+nPct(v*100,2)+'</td>';\n    case 'int':  return vazio ? '<td class=\"mut\">–</td>' : '<td>'+nInt(v)+'</td>';\n  }\n  return '<td>'+esc(v)+'</td>';\n}\n\n// ---------------------------------------------------------------- montagem de cada aba\nfunction countUp(el, to, ms){\n  if(reduceMotion || to < 2){ el.textContent = nInt(to); return; }\n  const t0 = performance.now();\n  (function step(now){\n    const p = Math.min(1, (now - t0) / ms), e = 1 - Math.pow(1 - p, 3);\n    el.textContent = nInt(Math.round(to * e));\n    if(p < 1) requestAnimationFrame(step);\n  })(t0);\n}\n\nconst ROW_H = 40;\n\nfunction build(t){\n  const root = $('panel-'+t.id);\n  const flagI = t.idx.flag;\n  const unit = t.unit || 'sellers';\n  const total = t.rows.length;\n  const hit = t.rows.reduce((s, r) => s + (r[flagI] === true ? 1 : 0), 0);\n  const miss = total - hit;\n  const pHit = total ? hit/total*100 : 0, pMiss = total ? miss/total*100 : 0;\n  t.state = {q:'', status:'all', sortCol:t.cols.findIndex(c => c.type==='prog'), sortDir:-1, view:t.rows};\n  const ph = t.searchPh || 'Buscar por Seller ID';\n\n  const goalsHtml = (!t.goals || !t.goals.length) ? '' : '<div class=\"goals\">'+t.goals.map(g => {\n    const n = t.rows.reduce((s, r) => s + (r[g.i] !== null && r[g.i] >= 1 ? 1 : 0), 0), p = total ? n/total*100 : 0;\n    return '<div class=\"goal\"><span class=\"gl\">'+esc(g.label)+'</span><div class=\"gbar\" role=\"img\" aria-label=\"'+nPct(p)+' bateram\"><i style=\"width:'+p.toFixed(2)+'%\"></i></div><span class=\"gn\"><b>'+nInt(n)+'</b> bateram · '+nPct(p)+'</span></div>';\n  }).join('')+'</div>';\n\n  const summaryHtml = t.hideGoalSummary\n    ? '<div class=\"cards\"><div class=\"card total\"><div class=\"lab\">Total de assessores</div><div class=\"num\" data-to=\"'+total+'\">0</div><div class=\"row\">Assessores na base de acompanhamento</div></div></div>'\n    : '<div class=\"cards\">'+\n        '<button type=\"button\" class=\"card total\" data-status=\"all\"><div class=\"lab\">'+esc(t.totalLabel || 'Total de sellers')+'</div><div class=\"num\" data-to=\"'+total+'\">0</div><div class=\"row\"><span class=\"badge y sm\">100%</span> da base total</div></button>'+\n        '<button type=\"button\" class=\"card ok\" data-status=\"hit\"><div class=\"lab\">'+esc(t.hitLabel || 'Bateram a meta')+'</div><div class=\"num\" data-to=\"'+hit+'\">0</div><div class=\"row\"><span class=\"badge okb\">'+nPct(pHit)+'</span> dos '+unit+'</div></button>'+\n        '<button type=\"button\" class=\"card bad\" data-status=\"miss\"><div class=\"lab\">'+esc(t.missLabel || 'Não bateram a meta')+'</div><div class=\"num\" data-to=\"'+miss+'\">0</div><div class=\"row\"><span class=\"badge warnb\">'+nPct(pMiss)+'</span> dos '+unit+'</div></button>'+\n      '</div>'+\n      '<div class=\"split\"><div class=\"split-top\"><span><b>'+nInt(hit)+'</b> bateram · <b>'+nInt(miss)+'</b> não bateram</span><span>Toque em um card para filtrar a tabela</span></div>'+\n        '<div class=\"split-bar\" role=\"img\" aria-label=\"'+nPct(pHit)+' bateram a meta e '+nPct(pMiss)+' não bateram\"><i class=\"s-ok\" style=\"width:calc('+pHit.toFixed(3)+'% - 1px)\"></i><i class=\"s-bad\" style=\"width:calc('+pMiss.toFixed(3)+'% - 1px)\"></i></div>'+goalsHtml+'</div>';\n\n  root.innerHTML = summaryHtml +\n    '<div class=\"panel\">'+\n      '<div class=\"panel-head\"><div><h2>Dados por '+esc(t.unitOne || 'seller')+'</h2><p>'+esc(t.subtitle)+'</p></div></div>'+\n      '<div class=\"controls\">'+\n        '<div class=\"search\"><input type=\"text\" autocomplete=\"off\" placeholder=\"'+esc(ph)+'\" aria-label=\"'+esc(ph)+'\"></div>'+\n        (t.hideGoalSummary ? '' : '<div class=\"quick\" role=\"group\" aria-label=\"Filtrar por status\">'+\n          '<button type=\"button\" data-status=\"all\">Todos</button><button type=\"button\" data-status=\"hit\">Bateram</button><button type=\"button\" data-status=\"miss\">Não bateram</button>'+\n        '</div>')+\n        '<button type=\"button\" class=\"ghost\" data-export>Exportar CSV</button>'+\n      '</div>'+\n      (t.hideGoalSummary\n        ? '<div class=\"legend\"><span><i class=\"key-dot\"></i>Dados de acompanhamento dos assessores</span><span><i class=\"lg y\"></i>Atingimento informado na planilha</span></div>'\n        : '<div class=\"legend\"><span><i class=\"key-dot\"></i>Colunas principais</span><span><i class=\"lg y\"></i>Progresso até a meta</span><span><i class=\"lg g\"></i>Meta batida</span><span>Barra cheia = meta atingida (100%)</span></div>')+\n      '<div class=\"tw\" tabindex=\"0\" aria-label=\"Lista\"><table class=\"dt\"><thead><tr>'+\n        t.cols.map((c,n) => '<th data-sort=\"'+n+'\" tabindex=\"0\" class=\"'+((c.type==='id'||c.type==='txt')?'l ':'')+(c.key?'key':'')+'\" title=\"Coluna original: '+esc(c.orig)+'\" aria-sort=\"none\">'+esc(c.label)+'<span class=\"ar\"></span></th>').join('')+\n      '</tr></thead><tbody></tbody></table></div>'+\n      '<div class=\"foot\"><span class=\"range\"></span><span>Role a lista para ver todos os '+unit+'</span></div>'+\n    '</div>';\n\n  root.querySelectorAll('.num').forEach(el => countUp(el, +el.dataset.to, 900));\n\n  const q = root.querySelector('.search input');\n  let tm; q.addEventListener('input', () => { clearTimeout(tm); tm = setTimeout(() => { t.state.q = q.value.trim(); refresh(t); }, 160); });\n  root.addEventListener('click', e => {\n    const s = e.target.closest('[data-status]'); if(s){ t.state.status = s.dataset.status; refresh(t); if(s.classList.contains('card')) root.querySelector('.panel').scrollIntoView({behavior: reduceMotion?'auto':'smooth', block:'start'}); return; }\n    if(e.target.closest('[data-export]')) { exportCsv(t); return; }\n    const th = e.target.closest('th[data-sort]'); if(th) sortBy(t, +th.dataset.sort);\n  });\n  root.addEventListener('keydown', e => { const th = e.target.closest('th[data-sort]'); if(th && (e.key==='Enter' || e.key===' ')){ e.preventDefault(); sortBy(t, +th.dataset.sort); } });\n  let raf = 0;\n  root.querySelector('.tw').addEventListener('scroll', () => { if(!raf) raf = requestAnimationFrame(() => { raf = 0; renderWindow(t); }); });\n  refresh(t);\n}\n\nfunction sortBy(t, n){\n  const st = t.state, ty = t.cols[n].type;\n  if(st.sortCol === n) st.sortDir = -st.sortDir; else { st.sortCol = n; st.sortDir = (ty==='id' || ty==='txt') ? 1 : -1; }\n  refresh(t);\n}\n\nfunction refresh(t){\n  const st = t.state, fI = t.idx.flag;\n  let v = t.rows;\n  if(st.status !== 'all') v = v.filter(r => st.status==='hit' ? r[fI] === true : r[fI] !== true);\n  if(st.q){ const qq = st.q.toLocaleLowerCase('pt-BR'); const campos = t.searchIdx || [0]; v = v.filter(r => campos.some(i => String(r[i] ?? '').toLocaleLowerCase('pt-BR').includes(qq))); }\n  if(st.sortCol !== null && st.sortCol >= 0){\n    const c = t.cols[st.sortCol], i = c.i, dir = st.sortDir, isId = c.type==='id';\n    v = v.slice().sort((a, b) => {\n      let x = a[i], y = b[i];\n      const nx = (x === null || x === undefined || x === ''), ny = (y === null || y === undefined || y === '');\n      if(nx && ny) return 0; if(nx) return 1; if(ny) return -1;\n      if(isId){ x = +x; y = +y; }\n      else if(typeof x === 'boolean'){ x = +x; y = +y; }\n      else if(typeof x === 'string' || typeof y === 'string') return String(x).localeCompare(String(y), 'pt-BR') * dir;\n      return x === y ? 0 : (x < y ? -dir : dir);\n    });\n  }\n  st.view = v;\n  const root = $('panel-'+t.id);\n  root.querySelectorAll('.quick button[data-status]').forEach(b => b.classList.toggle('on', b.dataset.status === st.status));\n  root.querySelectorAll('thead th').forEach((th, n) => {\n    const on = st.sortCol === n;\n    th.setAttribute('aria-sort', on ? (st.sortDir===1 ? 'ascending' : 'descending') : 'none');\n    th.querySelector('.ar').textContent = on ? (st.sortDir===1 ? '▲' : '▼') : '';\n  });\n  root.querySelector('.range').textContent = nInt(v.length)+' de '+nInt(t.rows.length)+' '+(t.unit || 'sellers')+' na lista';\n  root.querySelector('.tw').scrollTop = 0;\n  renderWindow(t);\n}\n\nfunction renderWindow(t){\n  const st = t.state, root = $('panel-'+t.id), box = root.querySelector('.tw'), tb = root.querySelector('tbody');\n  const n = st.view.length, cols = t.cols.length;\n  if(!n){ tb.innerHTML = '<tr><td colspan=\"'+cols+'\" class=\"empty\" style=\"text-align:center;font-family:var(--body);height:auto;padding:36px 20px\">Nenhum resultado encontrado. Ajuste a busca ou o filtro de status.</td></tr>'; return; }\n  const vh = box.clientHeight || 600;\n  const first = Math.max(0, Math.floor(box.scrollTop / ROW_H) - 8);\n  const last = Math.min(n, first + Math.ceil(vh / ROW_H) + 16);\n  const sp = h => h > 0 ? '<tr class=\"sp\" aria-hidden=\"true\" style=\"height:'+h+'px\"><td colspan=\"'+cols+'\" style=\"height:'+h+'px\"></td></tr>' : '';\n  let html = sp(first * ROW_H);\n  for(let i = first; i < last; i++){ const r = st.view[i]; html += '<tr>'+t.cols.map(c => cell(t, c, r)).join('')+'</tr>'; }\n  tb.innerHTML = html + sp((n - last) * ROW_H);\n}\n\nfunction exportCsv(t){\n  const num = v => (v === null || v === undefined) ? '' : (typeof v === 'boolean' ? (v ? 'Sim' : 'Não') : String(v).replace('.', ','));\n  const txt = v => '\"'+String(v === null || v === undefined ? '' : v).replace(/\"/g,'\"\"')+'\"';\n  const head = t.cols.map(c => txt(c.label)).join(';');\n  const lines = t.rows.map(r => t.cols.map(c => {\n    const v = r[c.i];\n    if(c.type==='id') return v;\n    if(c.type==='txt') return txt(v);\n    if(c.type==='flag') return v===true ? 'Sim' : 'Não';\n    if(c.type==='pct') return num(v===null ? null : Math.round(v*1e6)/1e8);\n    return num(v);\n  }).join(';'));\n  const blob = new Blob(['﻿' + head + '\\n' + lines.join('\\n')], {type:'text/csv;charset=utf-8'});\n  const a = document.createElement('a'); a.href = URL.createObjectURL(blob);\n  a.download = 'gamification_bf2026_'+t.id+'.csv'; document.body.appendChild(a); a.click(); a.remove();\n  setTimeout(() => URL.revokeObjectURL(a.href), 1000);\n}\n\n// ---------------------------------------------------------------- abas\nfunction show(id){\n  Object.keys(TABS).forEach(k => {\n    const on = k === id;\n    $('tab-'+k).setAttribute('aria-selected', on);\n    $('panel-'+k).hidden = !on;\n  });\n  const t = TABS[id];\n  $('meta-pill').innerHTML = id === 'acc' ? '' :\n  '<span>'+esc(t.metaText)+'</span><strong>'+esc(t.metaBadge || (t.meta+'%'))+'</strong>';\n  if(t.state) renderWindow(t);\n}\nObject.keys(TABS).forEach(k => $('tab-'+k).addEventListener('click', () => show(k)));\ndocument.querySelector('.tabs').addEventListener('keydown', e => {\n  if(e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;\n  const ks = Object.keys(TABS), cur = ks.findIndex(k => $('tab-'+k).getAttribute('aria-selected')==='true');\n  const nx = ks[(cur + (e.key==='ArrowRight' ? 1 : -1) + ks.length) % ks.length]; show(nx); $('tab-'+nx).focus();\n});\n\n$('gen-note').textContent = '';\nObject.values(TABS).forEach(build);\nshow('cp');\ndocument.body.classList.add('intro');\nsetTimeout(() => document.body.classList.remove('intro'), 1400);\n</script>\n</body>\n</html>\n",
